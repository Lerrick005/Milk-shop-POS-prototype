{
    "name": "shop-pos-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Idempotent sync API for the shop POS PWA",
    "main": "dist/server.js",
    "engines": {
      "node": ">=20.0.0"
    },
    "scripts": {
      "dev": "tsx watch src/server.ts",
      "build": "tsc -p tsconfig.json",
      "start": "node dist/server.js",
      "db:init": "tsx src/scripts/init-db.ts"
    },
    "dependencies": {
      "better-sqlite3": "^11.3.0",
      "cors": "^2.8.5",
      "express": "^4.19.2",
      "uuid": "^10.0.0"
    },
    "devDependencies": {
      "@types/better-sqlite3": "^7.6.11",
      "@types/cors": "^2.8.17",
      "@types/express": "^4.17.21",
      "@types/node": "^20.14.0",
      "@types/uuid": "^10.0.0",
      "tsx": "^4.16.0",
      "typescript": "^5.5.0"
    }
  }